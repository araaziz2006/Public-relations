<html lang="ckb" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>بەشی پەیوەندییە گشتییەکان | زانکۆی سلێمانی</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --red:#A82823;
    --black:#181410;
    --green:#1C6B45;
    --gold:#B8892B;
    --paper:#F6F1E6;
    --paper-2:#EFE7D6;
    --ink:#2A241C;
    --ink-soft:#5C5346;
    --line:rgba(24,20,16,0.14);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Noto Kufi Arabic','Segoe UI','Tahoma',Arial,sans-serif;
    background:var(--paper);
    color:var(--ink);
    overflow-x:hidden;
  }
  .serif{font-family:'Noto Kufi Arabic',sans-serif;}

  /* ================= NAV ================= */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(246,241,230,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav{
    max-width:1180px; margin:0 auto;
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 24px;
  }
  .brand{
    font-size:17px; font-weight:700; color:var(--black);
    display:flex; flex-direction:column; gap:2px;
  }
  .brand .brand-top{display:flex; align-items:center; gap:8px;}
  .brand .mark{
    width:26px; height:26px; border-radius:50%;
    border:1.5px solid var(--red);
    display:flex; align-items:center; justify-content:center;
    font-size:12px;
  }
  .nav-links{display:flex; gap:22px; list-style:none; flex-wrap:wrap;}
  .nav-links a{color:var(--ink-soft); text-decoration:none; font-weight:500; font-size:13.5px; transition:color .2s;}
  .nav-links a:hover{color:var(--red);}

  /* ================= HERO ================= */
  .hero-wrap{max-width:1180px; margin:0 auto; padding:64px 24px 0;}
  .hero-eyebrow{
    font-family:'Noto Kufi Arabic',sans-serif; font-weight:600; letter-spacing:0.5px;
    color:var(--green); font-size:15px; display:block; margin-bottom:18px;
    border-right:2px solid var(--gold); padding-right:12px;
  }
  .hero h1{
    font-size:44px; line-height:1.32; font-weight:900; color:var(--black);
    max-width:820px; margin-bottom:22px;
  }
  .hero h1 .accent{color:var(--red);}
  .hero p.lede{font-size:16.5px; color:var(--ink-soft); max-width:600px; line-height:1.85; margin-bottom:8px;}

  .ridge{width:100%; height:70px; display:block; margin-top:44px;}
  .ridge path{fill:none; stroke:var(--black); stroke-width:1.4; opacity:.55;}
  .ridge .fill{fill:var(--green); opacity:.10; stroke:none;}

  /* quick chapter strip */
  .chapters{max-width:1180px; margin:0 auto; padding:0 24px 10px;}
  .chapter-strip{
    display:flex; gap:0; flex-wrap:wrap; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
  }
  .chapter-strip a{
    flex:1 1 auto; text-align:center; padding:14px 10px; text-decoration:none;
    color:var(--ink-soft); font-size:13px; font-weight:600; border-left:1px solid var(--line);
    transition:background .2s, color .2s;
  }
  .chapter-strip a:first-child{border-left:none;}
  .chapter-strip a:hover{background:var(--paper-2); color:var(--red);}

  section{max-width:1180px; margin:0 auto; padding:64px 24px;}
  .tag{
    font-family:'Noto Kufi Arabic',sans-serif; font-weight:700; letter-spacing:0.5px; color:var(--green); font-size:13px; display:block; margin-bottom:10px;
  }
  .title{font-size:29px; font-weight:900; color:var(--black); margin-bottom:8px;}
  .sub{font-size:15px; color:var(--ink-soft); max-width:680px; margin-bottom:34px; line-height:1.85;}

  .card{
    background:#fff; border:1px solid var(--line); border-radius:6px; padding:30px;
  }

  /* ================= TIMELINE (history) ================= */
  .timeline{display:flex; flex-direction:column; gap:0; margin-bottom:30px;}
  .tl-item{display:flex; gap:20px; position:relative; padding-bottom:26px;}
  .tl-item:last-child{padding-bottom:0;}
  .tl-dot-col{display:flex; flex-direction:column; align-items:center; width:44px; flex-shrink:0;}
  .tl-dot{
    width:44px; height:44px; border-radius:50%; background:var(--black); color:var(--paper);
    display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px; flex-shrink:0;
  }
  .tl-item:nth-child(2) .tl-dot{background:var(--red);}
  .tl-item:nth-child(3) .tl-dot{background:var(--green);}
  .tl-line{width:1.5px; flex:1; background:var(--line); margin-top:6px;}
  .tl-body h4{font-size:15.5px; color:var(--black); margin-bottom:4px;}
  .tl-body p{font-size:13.5px; color:var(--ink-soft); line-height:1.7;}

  .history-text p{font-size:15px; color:var(--ink-soft); line-height:1.95;}
  .history-text p + p{margin-top:16px;}

  /* ================= STORY (pull quote) ================= */
  .story-card{
    background:var(--black); color:var(--paper); border-radius:6px; padding:44px 36px; position:relative;
  }
  .story-card::before{
    content:"”"; font-family:'Noto Kufi Arabic',sans-serif; font-size:90px; color:var(--gold); position:absolute; top:-6px; right:26px; opacity:.7;
  }
  .story-card p{font-family:'Noto Kufi Arabic',sans-serif; font-weight:400; font-size:16px; line-height:2.05; color:#EDE6D6;}
  .story-card p + p{margin-top:18px;}
  .story-sign{margin-top:26px; font-size:13.5px; color:var(--gold); font-weight:600;}

  /* ================= SCORES ================= */
  .scores-band{background:var(--black); color:var(--paper); border-radius:6px; padding:44px 36px;}
  .scores-band .tag{color:var(--gold);}
  .scores-band .title{color:#fff;}
  .scores-band .sub{color:#C9C0AE;}
  .plaque-row{display:flex; gap:22px; flex-wrap:wrap;}
  .plaque{
    flex:1 1 220px; border:1px solid rgba(246,241,230,0.25); border-radius:6px; padding:30px; text-align:center;
    background:rgba(246,241,230,0.04);
  }
  .plaque .num{font-size:56px; font-weight:900; color:var(--gold); line-height:1;}
  .plaque .lbl{font-size:14.5px; font-weight:600; margin-top:10px;}
  .plaque .yr{font-size:12px; color:#9A917E; margin-top:4px;}
  .note{
    margin-top:24px; border-top:1px dashed rgba(246,241,230,0.25); padding-top:18px;
    font-size:13px; color:#B9AF9C; line-height:1.8;
  }

  /* ================= GRIDS (subjects/careers/why) ================= */
  .grid3{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  .cell{background:var(--paper); padding:26px; transition:background .2s;}
  .cell:hover{background:#fff;}
  .cell .icon{font-size:24px; margin-bottom:12px;}
  .cell h3{font-size:15.5px; color:var(--black); margin-bottom:8px; font-weight:700;}
  .cell p{font-size:13px; color:var(--ink-soft); line-height:1.75;}

  .grid2{display:grid; grid-template-columns:repeat(2,1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  .cell-h{background:var(--paper); padding:22px; display:flex; gap:14px; align-items:flex-start; transition:background .2s;}
  .cell-h:hover{background:#fff;}
  .cell-h .icon{font-size:20px; width:38px; flex-shrink:0;}
  .cell-h h4{font-size:14.5px; color:var(--black); margin-bottom:5px; font-weight:700;}
  .cell-h p{font-size:12.5px; color:var(--ink-soft); line-height:1.65;}

  /* ================= CONTACT ================= */
  .contact-wrap{text-align:center;}
  .contact-wrap h2{font-size:27px; font-weight:900; color:var(--black); margin-bottom:12px;}
  .contact-wrap p{font-size:15px; color:var(--ink-soft); margin-bottom:6px;}
  .addr{font-size:13.5px; color:var(--ink-soft); margin-bottom:28px;}
  .contact-btns{display:flex; gap:14px; justify-content:center; flex-wrap:wrap;}
  .cbtn{
    display:inline-flex; align-items:center; gap:8px; text-decoration:none; font-weight:600; font-size:14px;
    padding:14px 24px; border-radius:4px; border:1.5px solid var(--black); color:var(--black); background:transparent;
    transition:all .2s;
  }
  .cbtn:hover{background:var(--black); color:var(--paper);}
  .cbtn.solid{background:var(--red); border-color:var(--red); color:#fff;}
  .cbtn.solid:hover{background:#8A1F1B;}

  footer{
    text-align:center; padding:40px 24px; color:var(--ink-soft); font-size:12.5px; border-top:1px solid var(--line);
    background:var(--paper-2);
  }
  footer .credit{font-size:14.5px; font-weight:700; color:var(--black); display:block; margin-bottom:8px;}
  footer .thanks{display:block; max-width:640px; margin:0 auto; line-height:1.8; color:#8A8171;}

  a:focus-visible, button:focus-visible{outline:2px solid var(--red); outline-offset:2px;}

  .reveal{margin-top:8px;}
  .reveal > summary{
    list-style:none; cursor:pointer; display:flex; align-items:center; gap:8px;
    color:var(--red); font-weight:800; font-size:19px; margin-bottom:28px; user-select:none; line-height:1.5;
  }
  .reveal > summary::-webkit-details-marker{display:none;}
  .reveal[open] > summary::after{content:" (داخستن)"; font-size:11px; color:var(--ink-soft); font-weight:400;}
  .reveal[open] > summary{margin-bottom:26px;}

  @media (max-width:860px){
    .hero h1{font-size:30px;}
    .grid3, .grid2{grid-template-columns:1fr;}
    .plaque-row{flex-direction:column;}
    .nav-links{display:none;}
    section{padding:44px 20px;}
  }
  @media (prefers-reduced-motion:reduce){*{transition:none !important;}}
</style>
